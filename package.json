{
  "name": "usdt-batch-payout",
  "version": "1.1.0",
  "description": "Batch USDT (BEP-20) payouts on BNB Smart Chain — CLI + desktop GUI, with validation, pre-flight checks and an idempotent ledger.",
  "type": "module",
  "main": "electron/main.cjs",
  "author": "Sendingmoney",
  "bin": {
    "payout": "src/cli.js"
  },
  "scripts": {
    "start": "node src/cli.js",
    "payout": "node src/cli.js",
    "make-example": "node scripts/make-example.js",
    "test": "node test/offline.test.mjs",
    "app": "electron .",
    "app:rebuild": "electron-builder install-app-deps",
    "pack:win": "electron-builder --win --dir",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win nsis"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "better-sqlite3": "^12.4.1",
    "dotenv": "^16.4.7",
    "viem": "^2.21.55",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@electron/fuses": "^1.8.0",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.personal.usdtbatchpayout",
    "productName": "USDT Batch Payout",
    "afterPack": "scripts/afterPack.cjs",
    "directories": {
      "output": "dist-app",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "renderer/**/*",
      "src/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
